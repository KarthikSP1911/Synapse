# Neon (or any Postgres) connection string used by the app and drizzle-kit
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# How much the server logs: debug, info, warn or error. Default: info in production, debug otherwise.
# Logs are one JSON object per line in production (see src/lib/logger.ts).
# LOG_LEVEL=info
